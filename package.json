{
  "name": "ledger",
  "version": "1.0.0",
  "description": "Personal Expense Tracker",
  "main": "main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "dev:vite": "cd frontend && vite",
    "dev:electron": "NODE_ENV=development node node_modules/electron/cli.js .",
    "build": "cd frontend && vite build",
    "preview": "cd frontend && vite preview",
    "dist": "npm run build && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "build": {
    "appId": "com.ledger.expensetracker",
    "productName": "Ledger",
    "directories": {
      "output": "release"
    },
    "files": [
      "main/**/*",
      "preload/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraFiles": [],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.finance"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
